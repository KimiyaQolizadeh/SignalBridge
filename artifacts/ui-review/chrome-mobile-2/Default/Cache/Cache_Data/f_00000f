    "import type { FinalSignal, TranscriptTurn } from '../types/transcript'\nimport { SignalCard } from './SignalCard'\nimport { StatusBadge } from './StatusBadge'\nimport { TranscriptWorkspace } from './TranscriptWorkspace'\n\ninterface SignalReviewWorkspaceProps {\n  drivers: FinalSignal[]\n  blockers: FinalSignal[]\n  selectedSignal: FinalSignal | null\n  selectedTurnId: number | null\n  turns: TranscriptTurn[]\n  turnsLoading: boolean\n  turnsError?: string | null\n  evidenceLocateFailed: boolean\n  onSelect: (signal: FinalSignal) => void\n  onViewTranscript: (signal: FinalSignal) => void\n  onRetryTurns: () => void\n}\n\nfunction SignalGroup({\n  title,\n  description,\n  signals,\n  selectedSignal,\n  onSelect,\n}: {\n  title: string\n  description: string\n  signals: FinalSignal[]\n  selectedSignal: FinalSignal | null\n  onSelect: (signal: FinalSignal) => void\n}) {\n  return (\n    <section className=\"signal-nav__group\">\n      <header><div><h4>{title}</h4><p>{description}</p></div><span>{signals.length}</span></header>\n      {signals.length ? (\n        <div className=\"signal-nav__list\">\n          {signals.map((signal) => {\n            const selected = selectedSignal === signal\n            return (\n              <button\n                className={`signal-nav__item signal-nav__item--${signal.item_type}${selected ? ' signal-nav__item--selected' : ''}`}\n                type=\"button\"\n                aria-pressed={selected}\n                onClick={() => onSelect(signal)}\n                key={`${signal.item_type}-${signal.rank}-${signal.category}`}\n              >\n                <span className=\"signal-nav__rank\">{signal.rank.toString().padStart(2, '0')}</span>\n                <span className=\"signal-nav__identity\"><strong>{signal.category}</strong><small>{signal.rationale}</small></span>\n                <span className=\"signal-nav__review\"><strong>{signal.final_score?.toFixed(2) ?? '—'}</strong><StatusBadge value={signal.validator_verdict} /></span>\n              </button>\n            )\n          })}\n        </div>\n      ) : <p className=\"signal-nav__empty\">No final {title.toLocaleLowerCase()} found.</p>}\n    </section>\n  )\n}\n\nexport function SignalReviewWorkspace({\n  drivers,\n  blockers,\n  selectedSignal,\n  selectedTurnId,\n  turns,\n  turnsLoading,\n  turnsError,\n  evidenceLocateFailed,\n  onSelect,\n  onViewTranscript,\n  onRetryTurns,\n}: SignalReviewWorkspaceProps) {\n  return (\n    <div className=\"signal-review-workspace\">\n      <nav className=\"signal-nav\" aria-label=\"Final signals\">\n        <SignalGroup title=\"Drivers\" description=\"Advisor motivations that may increase the likelihood of moving forward.\" signals={drivers} selectedSignal={selectedSignal} onSelect={onSelect} />\n        <SignalGroup title=\"Blockers\" description=\"Advisor concerns or conditions that may delay or prevent movement.\" signals={blockers} selectedSignal={selectedSignal} onSelect={onSelect} />\n      </nav>\n      <section className=\"selected-signal\" aria-live=\"polite\">\n        {selectedSignal ? (\n          <>\n            {selectedSignal.validator_verdict === 'needs_review' ? <p className=\"review-explanation\"><strong>Needs review.</strong> Grounded in the transcript, but the interpretation should be confirmed.</p> : null}\n            <SignalCard signal={selectedSignal} onViewEvidence={onViewTranscript} />\n            <div className=\"selected-signal__transcript\">\n              <header><div><p className=\"eyebrow\">Source evidence</p><h4>Transcript context</h4></div><button className=\"evidence-link\" type=\"button\" onClick={() => onViewTranscript(selectedSignal)}>Open full transcript <span aria-hidden=\"true\">→</span></button></header>\n              <TranscriptWorkspace turns={turns} selectedTurnId={selectedTurnId} selectedQuote={selectedSignal.advisor_quote} loading={turnsLoading} errorMessage={turnsError} evidenceLocateFailed={evidenceLocateFailed} onRetry={onRetryTurns} compact idPrefix=\"insight-turn\" />\n            </div>\n          </>\n        ) : <div className=\"selected-signal__empty\"><h4>Select an insight</h4><p>Choose a Driver or Blocker to review its rationale and transcript evidence.</p></div>}\n      </section>\n    </div>\n  )\n}\n"
  ]
}*/

