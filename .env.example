# Copy to .env and supply local values. Never commit real secrets.
OPENAI_API_KEY=
DATABASE_URL=postgresql+psycopg://signalbridge:signalbridge@localhost:5432/signalbridge
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
SPEAKER_CLASSIFIER_MODEL=gpt-4.1-mini
CANDIDATE_EXTRACTOR_MODEL=gpt-4.1-mini
EVIDENCE_VALIDATOR_MODEL=gpt-4.1
BUSINESS_SCORER_MODEL=gpt-4.1-mini
FINAL_RERANKER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
DEDUP_SIMILARITY_THRESHOLD=0.86
